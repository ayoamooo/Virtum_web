OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
JWT_SECRET=change_me_for_production
ALLOWED_ORIGINS=*
NODE_ENV=production
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# ========= Email (pick ONE approach; Resend is recommended on restricted networks) =========
# Priority if EMAIL_PROVIDER=auto (default): Resend API → SendGrid API → SMTP

# --- A) Resend (HTTPS API — works when SMTP ports 587/465 are blocked) ---
# Sign up: https://resend.com — create API key, paste below.
# RESEND_API_KEY=re_xxxxxxxx
# Optional "from" (testing without domain): use Resend's sandbox sender:
# EMAIL_FROM=Virtum <onboarding@resend.dev>
# For production, verify your domain in Resend and set e.g.:
# EMAIL_FROM=Virtum <noreply@yourdomain.com>

# --- B) SendGrid (HTTPS API) ---
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# EMAIL_FROM=Virtum <verified-sender@yourdomain.com>

# --- C) SMTP (Gmail, Brevo SMTP, etc.) — codes go TO users' emails; SMTP_* is only the sender account ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# If 587 times out, try: SMTP_PORT=465 and SMTP_SECURE=true
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Virtum <no-reply@yourdomain.com>"
